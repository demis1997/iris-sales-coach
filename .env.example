# Never commit real secrets. All paid operations are disabled by default.
APP_URL=http://localhost:8080
VITE_PUBLIC_SITE_URL=http://localhost:8080
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=  # optional service-role alias

# Explicit server-side provider. Demo routes request mock explicitly.
ARTEMIS_AI_PROVIDER=venice
VENICE_API_KEY=
VENICE_MODEL=
VENICE_FALLBACK_MODEL=
VENICE_INPUT_USD_PER_MILLION=
VENICE_OUTPUT_USD_PER_MILLION=
# Optional existing alternate provider; no implicit simulated fallback.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_INPUT_USD_PER_MILLION=
OPENAI_OUTPUT_USD_PER_MILLION=

# Real telephony and paid AI must be deliberately enabled by an operator.
ARTEMIS_ENABLE_REAL_CALLS=false
ARTEMIS_ENABLE_PAID_AI=false
ARTEMIS_ENABLE_VOICE=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VERIFY_SERVICE_SID=
TELEPHONY_SIGNING_SECRET=

# Persistent worker, behind a trusted TLS reverse proxy with WebSocket upgrades.
MEDIA_STREAM_PUBLIC_URL=
VOICE_BIND=127.0.0.1
VOICE_PORT=4400
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-3
TTS_PROVIDER=deepgram
DEEPGRAM_TTS_MODEL=
# Select ElevenLabs with a verified multilingual model/voice for Russian TTS.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=
ELEVENLABS_VOICE_ID=

# FXBO remains blocked pending official API contract and sandbox access.
# No invented endpoint or pretend-connected API-key field is provided.

# Existing optional integrations; not activated or verified by this work.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLISHABLE_KEY=
SENTRY_DSN=
ENCRYPTION_KEY=

# Physical deletion requires a separately reviewed expiring manifest.
ARTEMIS_ENABLE_ERASURE=false
