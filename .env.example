# Environment variables (names only — never commit secrets)

# ── App ──────────────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
# VITE_PUBLIC_SITE_URL=https://your-production-domain.com

# ── Supabase (Vite client uses VITE_*; server also reads SUPABASE_*) ─────────
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Spec aliases (map these in deployment if your host uses NEXT_PUBLIC_ names)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── AI providers (server-only) ───────────────────────────────────────────────
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
# ASSEMBLYAI_API_KEY=
# ELEVENLABS_API_KEY=
VITE_AI_PROVIDER=demo
ARTEMIS_AI_PROVIDER=demo
# ARTEMIS_AI_API_KEY=

# ── Billing (Phase 7) ────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# VITE_STRIPE_PUBLISHABLE_KEY=

# ── Security ─────────────────────────────────────────────────────────────────
ENCRYPTION_KEY=

# ── Monitoring ───────────────────────────────────────────────────────────────
SENTRY_DSN=
# VITE_SENTRY_DSN=
