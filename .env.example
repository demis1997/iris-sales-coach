# Environment variables (names only — never commit secrets)

# ── App ──────────────────────────────────────────────────────────────────────
APP_URL=https://www.project-artemis.ai
# VITE_PUBLIC_SITE_URL=https://www.project-artemis.ai

# ── Supabase (Vite client uses VITE_*; server also reads SUPABASE_*) ─────────
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Alias used by newer Supabase API keys (same secret as service role)
# SUPABASE_SECRET_KEY=
# SUPABASE_JWKS_URL=

# Spec aliases (map these in deployment if your host uses NEXT_PUBLIC_ names)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Telephony / Twilio (server-only) ─────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# TWILIO_CALLER_ID=
# Optional: Twilio Verify service (otherwise SMS OTP via Messages API)
# TWILIO_VERIFY_SERVICE_SID=
# Public URL Twilio webhooks hit (must be reachable): APP_URL above

# ── AI providers (server-only) ───────────────────────────────────────────────
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
# ASSEMBLYAI_API_KEY=
# ELEVENLABS_API_KEY=
VITE_AI_PROVIDER=demo
ARTEMIS_AI_PROVIDER=demo
# ARTEMIS_AI_API_KEY=

# Artemis sales coach
# Cursor Cloud API keys (crsr_…) currently power Cloud Agents / SDK — NOT a public
# /v1/chat/completions route. For live transcript coaching today:
#   1) Set OPENAI_API_KEY (used automatically if Cursor chat endpoint fails), OR
#   2) Point CURSOR_API_ENDPOINT at any OpenAI-compatible proxy you control.
LLM_PROVIDER=cursor
ARTEMIS_AI_PROVIDER=cursor
CURSOR_API_KEY=
CURSOR_API_ENDPOINT=https://api.cursor.com/v1/chat/completions
CURSOR_MODEL=composer-2
CURSOR_API_AUTH_MODE=basic
# DEBUG_LLM=1
# OPENAI_MODEL=gpt-4.1-mini


# ── Billing (Phase 7) ────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# VITE_STRIPE_PUBLISHABLE_KEY=

# ── Security ─────────────────────────────────────────────────────────────────
ENCRYPTION_KEY=

# ── Monitoring ───────────────────────────────────────────────────────────────
SENTRY_DSN=
# VITE_SENTRY_DSN=
